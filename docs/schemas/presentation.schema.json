{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avelin.dev/schemas/m1/presentation.schema.json",
  "title": "Avelin Presentation",
  "description": "Optional presentation object embedded in an Avelin manifest. Missing fields use defaults. Complete built-in zh-CN and en-US catalogs are overlaid only by overrides in the same language. Auto detection resolves supported zh/en language tags; an unsupported or absent system locale resolves to fallback_locale. Runtime validation remains required for PNG decoding and resource limits.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "template": {
      "type": "string",
      "const": "compact",
      "default": "compact"
    },
    "locale": {
      "enum": [
        "auto",
        "zh-CN",
        "en-US"
      ],
      "default": "auto"
    },
    "fallback_locale": {
      "enum": [
        "zh-CN",
        "en-US"
      ],
      "default": "en-US",
      "description": "Used when automatic system locale detection has no supported match; does not replace individual missing keys with another language."
    },
    "theme": {
      "enum": [
        "light",
        "dark"
      ],
      "default": "light"
    },
    "accent_color": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "pattern": "^#[0-9a-fA-F]{6}$",
      "default": "#36594C",
      "description": "Opaque brand color. The UI must choose black or white foreground using accent_foreground_rgb and preserve adequate contrast for hover and active states."
    },
    "logo_png": {
      "default": null,
      "description": "Embedded static PNG bytes, not a path, URL or base64 string. Runtime fully decodes PNG with checksum checking, a 16 MiB decoder allocation limit, a 4 MiB pixel output limit and a 512 KiB cumulative decoded profile/text limit. Width and height must each be 1..1024; APNG and trailing data are rejected.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 524288,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      ]
    },
    "strings": {
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "zh-CN": {
          "$ref": "#/$defs/catalog"
        },
        "en-US": {
          "$ref": "#/$defs/catalog"
        }
      },
      "description": "Partial overrides. Keys are registered; unknown keys, blank values and changed placeholder sets are invalid. Values are plain text; interpolation never interprets argument values as placeholders or markup. Underlying execution diagnostics are not translated."
    }
  },
  "$defs": {
