{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avelin.dev/schemas/m1/model.schema.json",
  "title": "Avelin model schemas 1 and 2",
  "description": "Current structural contract for legacy schema 1 and schema 2 components, install scope, prerequisites and update configuration. Runtime additionally validates package identity, Windows paths and security, ownership, selections, statistics and operation-specific evidence.",
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "FileResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "component_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "app_id",
        "app_name",
        "app_version",
        "entry",
        "directory_name",
        "files"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            1,
            2
          ]
        },
        "app_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "app_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "app_version": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "directory_name": {
          "type": "string",
          "minLength": 1
        },
        "start_menu_shortcut": {
          "type": "boolean",
          "description": "Default selection for a Programs shortcut in the configured installation scope; runtime choice may override it.",
          "default": false
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/FileResource"
          }
        },
        "runtime_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "presentation": {
          "anyOf": [
            {
              "$ref": "presentation.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "desktop_shortcut": {
          "type": "boolean",
          "default": false,
          "description": "Default selection for a Desktop shortcut in the configured installation scope; runtime choice may override it."
        },
        "components": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/ComponentDefinition"
          }
        },
        "install_scope": {
          "$ref": "#/$defs/InstallScope"
        },
        "prerequisites": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/Prerequisite"
          },
          "description": "Each prerequisite kind occurs at most once; numeric version semantics are enforced in Rust."
        },
        "updates": {
          "anyOf": [
            {
              "$ref": "#/$defs/UpdateConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "components": {
                "maxItems": 0
              },
              "files": {
                "items": {
                  "$ref": "#/$defs/FileResourceV1"
                }
              }
            }
          },
          "else": {
            "required": [
              "components"
            ],
            "properties": {
              "components": {
                "minItems": 1,
                "contains": {
                  "properties": {
                    "id": {
                      "const": "core"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              "files": {
                "items": {
                  "$ref": "#/$defs/FileResourceV2"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "install_scope": {
                "const": "current_user"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "prerequisites": {
                "maxItems": 0
              },
              "updates": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "app_id",
        "app_version",
        "installation_id",
        "task_id",
        "commit_id",
        "install_dir",
        "manifest_sha256",
        "user_sid",
        "files"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            1,
            2
          ]
        },
        "app_id": {
          "type": "string"
        },
        "app_version": {
          "type": "string"
        },
        "installation_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "commit_id": {
          "type": "string"
        },
        "install_dir": {
          "type": "string"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "uninstaller_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_sid": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileResource"
          }
        },
        "shortcuts": {
          "type": "array",
          "maxItems": 2,
          "default": [],
          "items": {
            "$ref": "#/$defs/ShortcutRecord"
          }
        },
        "previous_commit_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,100}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Preceding successful commit, absent on a fresh install or legacy receipt."
        },
        "selected_components": {
          "$ref": "#/$defs/LegacyOrComponentSelection"
        },
        "install_scope": {
          "$ref": "#/$defs/InstallScope"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "selected_components": {
                "maxItems": 0
              },
              "files": {
                "items": {
                  "$ref": "#/$defs/FileResourceV1"
                }
              }
            }
          },
          "else": {
            "required": [
              "selected_components"
            ],
            "properties": {
              "selected_components": {
                "$ref": "#/$defs/ComponentSelection"
              },
              "files": {
                "minItems": 1,
                "maxItems": 50000,
                "items": {
                  "$ref": "#/$defs/FileResourceV2"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "install_scope": {
                "const": "current_user"
              }
            }
          }
        }
      ]
    },
    "InstallPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "operation",
        "app_id",
        "app_version",
        "install_dir",
        "user_sid",
        "manifest_sha256",
        "payload_file_count",
        "payload_bytes",
        "start_menu_shortcut"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            1,
            2
          ]
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "operation": {
          "enum": [
            "install",
            "uninstall",
            "upgrade",
            "repair",
            "recover",
            "modify"
          ]
        },
        "app_id": {
          "type": "string"
        },
        "app_version": {
          "type": "string"
        },
        "install_dir": {
          "type": "string",
          "minLength": 1
        },
        "user_sid": {
          "type": "string",
          "pattern": "^S-1-(?:[0-9]+-)*[0-9]+$",
          "maxLength": 184
        },
        "manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "payload_file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        },
        "payload_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "start_menu_shortcut": {
          "type": "boolean",
          "description": "Actual selected option, independent of the packaged default."
        },
        "desktop_shortcut": {
          "type": "boolean",
          "default": false,
          "description": "Actual selected option for this operation."
        },
        "upgrade": {
          "anyOf": [
            {
              "$ref": "#/$defs/UpgradePlan"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_components": {
          "$ref": "#/$defs/LegacyOrComponentSelection"
        },
        "selection_source": {
          "anyOf": [
            {
              "enum": [
                "default",
                "inherited",
                "explicit",
                "legacy_migration",
                "receipt"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "package_payload_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "install_scope": {
          "$ref": "#/$defs/InstallScope"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "upgrade",
                  "modify"
                ]
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "required": [
              "upgrade"
            ],
            "properties": {
              "upgrade": {
                "$ref": "#/$defs/UpgradePlan"
              }
            }
          },
          "else": {
            "properties": {
              "upgrade": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "operation": {
                "not": {
                  "const": "modify"
                }
              },
              "selected_components": {
                "maxItems": 0
              },
              "selection_source": {
                "type": "null"
              },
              "package_payload_bytes": {
                "type": "null"
              },
              "upgrade": {
                "properties": {
                  "selected_components": {
                    "maxItems": 0
                  },
                  "previous_selected_components": {
                    "maxItems": 0
                  }
                }
              }
            }
          },
          "else": {
            "required": [
              "selected_components",
              "selection_source",
              "package_payload_bytes"
            ],
            "properties": {
              "selected_components": {
                "$ref": "#/$defs/ComponentSelection"
              },
              "selection_source": {
                "type": "string"
              },
              "package_payload_bytes": {
                "type": "integer"
              },
              "upgrade": {
                "required": [
                  "selected_components"
                ],
                "properties": {
                  "selected_components": {
                    "$ref": "#/$defs/ComponentSelection"
                  },
                  "diff": {
                    "properties": {
                      "added": {
                        "items": {
                          "$ref": "#/$defs/FileResourceV2"
                        }
                      },
                      "unchanged": {
                        "items": {
                          "$ref": "#/$defs/FileResourceV2"
                        }
                      },
                      "replaced": {
                        "items": {
                          "properties": {
                            "after": {
                              "$ref": "#/$defs/FileResourceV2"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "modify"
              }
            }
          },
          "then": {
            "properties": {
              "schema_version": {
                "const": 2
              },
              "upgrade": {
                "required": [
                  "previous_selected_components",
                  "modify_snapshot_sha256",
                  "backend_sha256"
                ],
                "properties": {
                  "previous_selected_components": {
                    "$ref": "#/$defs/ComponentSelection"
                  },
                  "modify_snapshot_sha256": {
                    "$ref": "#/$defs/Sha256"
                  },
                  "backend_sha256": {
                    "$ref": "#/$defs/Sha256"
                  },
                  "diff": {
                    "properties": {
                      "replaced": {
                        "maxItems": 0
                      }
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "upgrade": {
                "properties": {
                  "modify_snapshot_sha256": {
                    "type": "null"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "install_scope": {
                "const": "current_user"
              }
            }
          }
        }
      ]
    },
    "ShortcutRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "target",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "desktop",
            "start_menu"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "FileReplacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "$ref": "#/$defs/FileResource"
        },
        "after": {
          "$ref": "#/$defs/FileResource"
        }
      }
    },
    "UpgradeDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "replaced",
        "removed",
        "unchanged"
      ],
      "properties": {
        "added": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/FileResource"
          }
        },
        "replaced": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/FileReplacement"
          }
        },
        "removed": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/FileResource"
          }
        },
        "unchanged": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/FileResource"
          }
        }
      }
    },
    "UpgradePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous_version",
        "previous_manifest_sha256",
        "previous_receipt_sha256",
        "previous_task_id",
        "previous_commit_id",
        "installation_id",
        "diff",
        "staging_dir",
        "backup_dir",
        "required_space_bytes"
      ],
      "properties": {
        "previous_version": {
          "type": "string",
          "minLength": 1
        },
        "previous_manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "previous_receipt_sha256": {
          "$ref": "#/$defs/Sha256",
          "description": "SHA-256 of the exact prior receipt bytes, not a reserialization."
        },
        "previous_task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "previous_commit_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "installation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "diff": {
          "$ref": "#/$defs/UpgradeDiff"
        },
        "staging_dir": {
          "type": "string",
          "minLength": 1
        },
        "backup_dir": {
          "type": "string",
          "minLength": 1
        },
        "required_space_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Conservative staging, backup and deployment estimate; runtime validates its minimum and actual free space."
        },
        "selected_components": {
          "$ref": "#/$defs/LegacyOrComponentSelection"
        },
        "previous_selected_components": {
          "$ref": "#/$defs/LegacyOrComponentSelection"
        },
        "modify_snapshot_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "backend_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ComponentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "ComponentSelection": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "contains": {
        "const": "core"
      },
      "items": {
        "$ref": "#/$defs/ComponentId"
      },
      "description": "Canonical sorted complete selection; lexical ordering and manifest membership are checked by Rust."
    },
    "LegacyOrComponentSelection": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 0
        },
        {
          "$ref": "#/$defs/ComponentSelection"
        }
      ]
    },
    "ComponentDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "required": {
          "type": "boolean"
        },
        "default_selected": {
          "type": "boolean",
          "default": false
        },
        "name": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zh-CN",
            "en-US"
          ],
          "properties": {
            "zh-CN": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            "en-US": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            }
          }
        },
        "description": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zh-CN",
            "en-US"
          ],
          "properties": {
            "zh-CN": {
              "type": "string",
              "minLength": 1,
              "maxLength": 320,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            "en-US": {
              "type": "string",
              "minLength": 1,
              "maxLength": 320,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "core"
              }
            }
          },
          "then": {
            "required": [
              "default_selected"
            ],
            "properties": {
              "required": {
                "const": true
              },
              "default_selected": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "required": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "FileResourceV1": {
      "allOf": [
        {
          "$ref": "#/$defs/FileResource"
        },
        {
          "properties": {
            "component_id": {
              "type": "null"
            }
          }
        }
      ]
    },
    "FileResourceV2": {
      "allOf": [
        {
          "$ref": "#/$defs/FileResource"
        },
        {
          "required": [
            "component_id"
          ],
          "properties": {
            "component_id": {
              "$ref": "#/$defs/ComponentId"
            }
          }
        }
      ]
    },
    "InstallScope": {
      "type": "string",
      "enum": [
        "current_user",
        "all_users"
      ],
      "default": "current_user",
      "description": "Omitted legacy values mean current_user. All-user resources require validated Program Files ownership and an elevated process."
    },
    "Prerequisite": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "min_version"
          ],
          "properties": {
            "kind": {
              "const": "vc_redist_x64"
            },
            "min_version": {
              "type": "string",
              "pattern": "^14\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "min_version"
          ],
          "properties": {
            "kind": {
              "const": "dotnet_desktop_x64"
            },
            "min_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "min_version"
          ],
          "properties": {
            "kind": {
              "const": "webview2_evergreen"
            },
            "min_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        }
      ]
    },
    "UpdateConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feed_url"
      ],
      "properties": {
        "feed_url": {
          "type": "string",
          "minLength": 9,
          "maxLength": 8192,
          "pattern": "^https://[^/\\s\\\\#@?]+(?:[/?][^\\s\\\\#]*)?$",
          "description": "Runtime additionally rejects credentials, invalid authorities, malformed percent escapes and non-ASCII URLs."
        },
        "channel": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$",
          "default": "stable"
        }
      }
    }
  }
}
