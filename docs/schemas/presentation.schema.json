        "window.title": {
          "type": "string",
          "minLength": 1,
          "description": "Plain UI text. Required placeholder set: {app_name}. Repetition is allowed; all other braces are invalid.",
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^(?:[^{}]|\\{(?:app_name)\\})*$"
            },
            {
              "pattern": "\\{app_name\\}"
            }
          ]
        },
        "header.demo": {
          "type": "string",
          "minLength": 1,
          "description": "Plain UI text without placeholders or braces.",
