{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avelin.dev/schemas/m1/model.schema.json",
  "title": "Avelin M1/M2/M3 model drafts",
  "description": "Draft structure only. Runtime validation also checks path boundaries, actual resources, caller identity and manifest binding. This is not a published compatibility promise.",
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "FileResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "app_id",
        "app_name",
        "app_version",
        "entry",
        "directory_name",
        "files"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "app_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "app_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "app_version": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "directory_name": {
          "type": "string",
          "minLength": 1
        },
        "start_menu_shortcut": {
          "type": "boolean",
          "description": "Default selection for a current-user Programs shortcut; runtime choice may override it.",
          "default": false
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/FileResource"
          }
        },
        "runtime_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "presentation": {
          "anyOf": [
            {
              "$ref": "presentation.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "desktop_shortcut": {
          "type": "boolean",
          "default": false,
          "description": "Default selection for a current-user Desktop shortcut; runtime choice may override it."
        }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "app_id",
        "app_version",
        "installation_id",
        "task_id",
        "commit_id",
        "install_dir",
        "manifest_sha256",
        "user_sid",
        "files"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "app_id": {
          "type": "string"
        },
        "app_version": {
          "type": "string"
        },
        "installation_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "commit_id": {
          "type": "string"
        },
        "install_dir": {
          "type": "string"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "uninstaller_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_sid": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileResource"
          }
        },
        "shortcuts": {
          "type": "array",
          "maxItems": 2,
          "default": [],
          "items": {
            "$ref": "#/$defs/ShortcutRecord"
          }
        },
        "previous_commit_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,100}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Preceding successful commit, absent on a fresh install or legacy receipt."
        }
      }
    },
    "InstallPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "operation",
        "app_id",
        "app_version",
        "install_dir",
        "user_sid",
        "manifest_sha256",
        "payload_file_count",
        "payload_bytes",
        "start_menu_shortcut"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "operation": {
          "enum": [
            "install",
            "uninstall",
            "upgrade"
          ]
        },
        "app_id": {
          "type": "string"
        },
        "app_version": {
          "type": "string"
        },
        "install_dir": {
          "type": "string",
          "minLength": 1
        },
        "user_sid": {
          "type": "string",
          "pattern": "^S-1-(?:[0-9]+-)*[0-9]+$",
          "maxLength": 184
        },
        "manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "payload_file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        },
        "payload_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "start_menu_shortcut": {
          "type": "boolean",
          "description": "Actual selected option, independent of the packaged default."
        },
        "desktop_shortcut": {
          "type": "boolean",
          "default": false,
          "description": "Actual selected option for this operation."
        },
        "upgrade": {
          "anyOf": [
            {
              "$ref": "#/$defs/UpgradePlan"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "upgrade"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "required": [
              "upgrade"
            ],
            "properties": {
              "upgrade": {
                "$ref": "#/$defs/UpgradePlan"
              }
            }
          },
          "else": {
            "properties": {
              "upgrade": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ShortcutRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "target",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "desktop",
            "start_menu"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "FileReplacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "$ref": "#/$defs/FileResource"
        },
        "after": {
          "$ref": "#/$defs/FileResource"
        }
      }
    },
    "UpgradeDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "replaced",
        "removed",
        "unchanged"
      ],
      "properties": {
        "added": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/FileResource"
          }
        },
        "replaced": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/FileReplacement"
          }
        },
        "removed": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/FileResource"
          }
        },
        "unchanged": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/FileResource"
          }
        }
      }
    },
    "UpgradePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous_version",
        "previous_manifest_sha256",
        "previous_receipt_sha256",
        "previous_task_id",
        "previous_commit_id",
        "installation_id",
        "diff",
        "staging_dir",
        "backup_dir",
        "required_space_bytes"
      ],
      "properties": {
        "previous_version": {
          "type": "string",
          "minLength": 1
        },
        "previous_manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "previous_receipt_sha256": {
          "$ref": "#/$defs/Sha256",
          "description": "SHA-256 of the exact prior receipt bytes, not a reserialization."
        },
        "previous_task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "previous_commit_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "installation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "diff": {
          "$ref": "#/$defs/UpgradeDiff"
        },
        "staging_dir": {
          "type": "string",
          "minLength": 1
        },
        "backup_dir": {
          "type": "string",
          "minLength": 1
        },
        "required_space_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Conservative staging, backup and deployment estimate; runtime validates its minimum and actual free space."
        }
      }
    }
  }
}
